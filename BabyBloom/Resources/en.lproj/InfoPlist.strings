/* Per-locale app name and permission prompts. Together with "brand.name" in
   Resources/Localization/<locale>.json this is the single place that decides
   what this locale calls the app. The base Info.plist carries the English
   fallback used by locales we do not ship. */
"CFBundleDisplayName" = "BloomNest";

"NSUserNotificationsUsageDescription" = "BloomNest sends reminders about feeding, sleep and other baby care events.";
"NSPhotoLibraryUsageDescription" = "Used to pick a photo for your baby's profile.";
"NSFaceIDUsageDescription" = "Used to unlock the app quickly.";
